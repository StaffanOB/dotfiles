" --- DATABRICKS SETTINGS ---

" Databricks configuration (from ~/.databrickscfg [DEFAULT] profile)
let g:databricks_profile = 'DEFAULT'

" Workspace settings
let g:databricks_host = 'https://adb-7405617670305035.15.azuredatabricks.net/'
let g:databricks_workspace_dir = '/Workspace/Users/staffan_toor.se#ext#@staffantoor.onmicrosoft.com/.bundle/'

" Cluster ID - You need to set this to your cluster ID
" Find it in Databricks UI → Compute → Select your cluster → Copy Cluster ID
" Example: let g:databricks_cluster_id = '0123-456789-abc12345'
