{
  "coc.preferences.formatOnSaveFiletypes": [
    "css",
    "markdown",
    "javascript",
    "graphql",
    "html",
    "yaml",
    "json",
    "python",
    "typescript",
    "robot"
  ],

  // Python config
  "python.jediEnabled": false,
  "python.linting.enabled": true,
  "python.linting.pylintEnabled": true,

  // Snippets
  "snippets.ultisnips.directories": ["UltiSnips"],

  // VimTeX
  "coc.source.vimtex.filetypes": ["tex", "plaintex"],

  // Prettier / ESLint
  "prettier.tslintIntegration": true,
  "prettier.eslintIntegration": false,
  "eslint.packageManager": "yarn",
  "eslint.nodePath": ".yarn/sdks",
  "workspace.workspaceFolderCheckCwd": false,
  "tsserver.tsdk": ".yarn/sdks/typescript/lib",

  // === Robot Framework LSP ===
  "languageserver": {
    "robot": {
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "robotframework_ls"],
      "filetypes": ["robot"],
      "settings": {
        // enable Robotidy formatting
        "robot.language-server.formatter": "robotidy",
        // enable Robocop linting
        "robot.language-server.lint": ["robocop"],
        // set pythonpath/libraries if needed
        "robot.pythonpath": ["./resources", "./libs"],
        "robot.libraries": ["SeleniumLibrary", "Collections"]
      }
    }
  }
}
