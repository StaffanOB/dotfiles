" ==============================================================================
" vim-lsp Configuration (Replaces CoC)
" ==============================================================================

" --- LSP GENERAL SETTINGS ---

" Enable diagnostics
let g:lsp_diagnostics_enabled = 1
let g:lsp_diagnostics_echo_cursor = 1
let g:lsp_diagnostics_echo_delay = 200
let g:lsp_diagnostics_float_cursor = 0
let g:lsp_diagnostics_virtual_text_enabled = 0  " Disable inline text (less noise)
let g:lsp_diagnostics_signs_enabled = 1
let g:lsp_diagnostics_highlights_enabled = 1

" Diagnostic signs (matches CoC style)
let g:lsp_diagnostics_signs_error = {'text': '✗'}
let g:lsp_diagnostics_signs_warning = {'text': '⚠'}
let g:lsp_diagnostics_signs_information = {'text': 'i'}
let g:lsp_diagnostics_signs_hint = {'text': '💡'}

" Highlight references when cursor holds
let g:lsp_document_highlight_enabled = 1
let g:lsp_document_highlight_delay = 500

" Show signature help
let g:lsp_signature_help_enabled = 1

" Preview window for hover/definition
let g:lsp_preview_float = 0
let g:lsp_preview_autoclose = 1

" Performance
let g:lsp_async_completion = 1
let g:lsp_log_file = ''  " Disable logging for performance

" --- LANGUAGE SERVER SETTINGS ---

" Auto-install language servers via vim-lsp-settings
let g:lsp_settings_enable_suggestions = 1

" Python - Use pyright (faster than pylsp)
let g:lsp_settings_filetype_python = ['pyright-langserver']

" JavaScript/TypeScript - NO LSP (syntax highlighting only as requested)
" Explicitly disable TS/JS LSP
let g:lsp_settings_filetype_javascript = []
let g:lsp_settings_filetype_typescript = []

" --- ROBOT FRAMEWORK LSP (Lazy-loaded) ---
" Only register when opening .robot files
if executable('python3')
  augroup LspRobotFramework
    autocmd!
    autocmd FileType robot call s:setup_robot_lsp()
  augroup END

  function! s:setup_robot_lsp() abort
    " Only register once
    if exists('g:lsp_robot_registered')
      return
    endif
    let g:lsp_robot_registered = 1

    " Check if robotframework_ls is available
    if !executable('python3')
      echohl WarningMsg
      echo "robotframework_ls requires python3. Install: pip install robotframework-lsp"
      echohl None
      return
    endif

    call lsp#register_server({
      \ 'name': 'robotframework-ls',
      \ 'cmd': {server_info->['python3', '-m', 'robotframework_ls']},
      \ 'allowlist': ['robot'],
      \ 'workspace_config': {
      \   'robot': {
      \     'language-server': {
      \       'formatter': 'robotidy',
      \       'lint': ['robocop'],
      \     },
      \     'pythonpath': ['./resources', './libs'],
      \     'libraries': ['SeleniumLibrary', 'Collections']
      \   }
      \ }
      \ })
  endfunction
endif

" --- KEYBINDINGS (Same as CoC) ---

" Go-to navigation
nmap <silent> gd <Plug>(lsp-definition)
nmap <silent> gy <Plug>(lsp-type-definition)
nmap <silent> gi <Plug>(lsp-implementation)
nmap <silent> gr <Plug>(lsp-references)

" Hover documentation
nmap <silent> K <Plug>(lsp-hover)

" Diagnostics navigation (same as CoC)
nmap <silent> [g <Plug>(lsp-previous-diagnostic)
nmap <silent> ]g <Plug>(lsp-next-diagnostic)

" Symbol renaming
nmap <leader>rn <Plug>(lsp-rename)

" Code actions
nmap <leader>a <Plug>(lsp-code-action)
nmap <leader>qf <Plug>(lsp-code-action)

" Format document
nmap <leader>f <Plug>(lsp-document-format)
xmap <leader>f <Plug>(lsp-document-range-format)

" Workspace symbols
nmap <leader>ws <Plug>(lsp-workspace-symbol)

" Document symbols (class outline)
nmap <leader>cs <Plug>(lsp-document-symbol)

" Code lens
nmap <leader>cl <Plug>(lsp-code-lens)

" Peek definition (preview without jumping)
nmap <silent> gp <Plug>(lsp-peek-definition)

" --- ASYNCOMPLETE SETTINGS (Autocomplete) ---

" Enable auto-popup
let g:asyncomplete_auto_popup = 1
let g:asyncomplete_auto_completeopt = 0
let g:asyncomplete_popup_delay = 100
let g:asyncomplete_min_chars = 1

" Close preview window after completion
autocmd! CompleteDone * if pumvisible() == 0 | silent! pclose | endif

" Tab completion (same as CoC behavior)
inoremap <expr> <Tab>   pumvisible() ? "\<C-n>" : "\<Tab>"
inoremap <expr> <S-Tab> pumvisible() ? "\<C-p>" : "\<S-Tab>"
inoremap <expr> <CR>    pumvisible() ? asyncomplete#close_popup() . "\<CR>" : "\<CR>"

" Trigger completion manually (same as CoC: Ctrl-Space)
imap <C-Space> <Plug>(asyncomplete_force_refresh)
imap <C-@> <Plug>(asyncomplete_force_refresh)

" --- SETTINGS FOR SPECIFIC FILETYPES ---

" Python specific settings
augroup LspPython
  autocmd!
  autocmd FileType python setlocal omnifunc=lsp#complete
  autocmd FileType python setlocal signcolumn=yes
  autocmd FileType python setlocal updatetime=300
augroup END

" Robot Framework specific settings
augroup LspRobot
  autocmd!
  autocmd FileType robot setlocal omnifunc=lsp#complete
  autocmd FileType robot setlocal signcolumn=yes
augroup END

" --- COMMANDS ---

" Format command (same as CoC)
command! -nargs=0 Format :LspDocumentFormat

" Organize imports (if supported by language server)
command! -nargs=0 OR :LspCodeAction source.organizeImports

" Show all diagnostics in quickfix
command! -nargs=0 LspDiagnostics :LspDocumentDiagnostics

" --- STATUS LINE INTEGRATION ---

" Function to get LSP status for statusline
function! LspStatus() abort
  if !exists('*lsp#get_server_status')
    return ''
  endif
  
  let l:counts = {}
  let l:bufnr = bufnr('%')
  
  if lsp#get_buffer_diagnostics_counts(l:bufnr) != {}
    let l:counts = lsp#get_buffer_diagnostics_counts(l:bufnr)
  endif
  
  let l:errors = get(l:counts, 'error', 0)
  let l:warnings = get(l:counts, 'warning', 0)
  
  if l:errors == 0 && l:warnings == 0
    return ''
  endif
  
  return printf('E:%d W:%d', l:errors, l:warnings)
endfunction

" Make status available for statusline plugins
set statusline^=%{LspStatus()}

