" ==============================================================================
" ALE Configuration - Optimized for Performance
" ==============================================================================

" --- LINTERS CONFIGURATION ---

" Use only fast, modern linters
let g:ale_linters = {
\   'python': ['ruff'],
\   'javascript': [],
\   'typescript': [],
\   'robot': [],
\   'json': [],
\   'yaml': [],
\}

" Explicitly disable linters for filetypes we don't want linted
let g:ale_linters_explicit = 1

" --- FIXERS CONFIGURATION ---

let g:ale_fixers = {
\   'python': ['ruff', 'black'],
\   'javascript': ['prettier'],
\   'typescript': ['prettier'],
\   'json': ['prettier'],
\   'yaml': ['prettier'],
\   'css': ['prettier'],
\   'html': ['prettier'],
\   'markdown': ['prettier'],
\}

" Fix files on save
let g:ale_fix_on_save = 1

" --- PERFORMANCE OPTIMIZATIONS ---

" Only lint on save (not on text change or insert leave)
let g:ale_lint_on_text_changed = 'never'
let g:ale_lint_on_insert_leave = 0
let g:ale_lint_on_enter = 0
let g:ale_lint_on_save = 1
let g:ale_lint_on_filetype_changed = 0

" Don't run linters when opening large files (>500KB)
let g:ale_maximum_file_size = 500000

" Limit number of linters running in parallel
let g:ale_max_buffer_history_size = 20

" Disable ALE's LSP features (we use vim-lsp)
let g:ale_disable_lsp = 1

" --- DISPLAY SETTINGS ---

" Sign column
let g:ale_sign_error = '✗'
let g:ale_sign_warning = '⚠'
let g:ale_sign_info = 'i'

" Always show sign column
let g:ale_sign_column_always = 1

" Message format
let g:ale_echo_msg_format = '[%linter%] %s [%severity%]'
let g:ale_echo_msg_error_str = 'E'
let g:ale_echo_msg_warning_str = 'W'
let g:ale_echo_msg_info_str = 'I'

" Virtual text (inline messages) - disabled for performance
let g:ale_virtualtext_cursor = 0

" Loclist/quickfix
let g:ale_set_loclist = 1
let g:ale_set_quickfix = 0
let g:ale_open_list = 0
let g:ale_keep_list_window_open = 0

" Highlights
let g:ale_set_highlights = 1

" --- PYTHON SPECIFIC SETTINGS ---

" Ruff configuration
let g:ale_python_ruff_executable = 'ruff'
let g:ale_python_ruff_options = '--select=E,F,W,I,N,UP,YTT,ANN,S,BLE,B,A,COM,C4,DTZ,ISC,ICN,PIE,PT,RSE,RET,SIM,TID,ARG,PD,PGH,PL,TRY,NPY,RUF'
let g:ale_python_ruff_use_global = 0
let g:ale_python_ruff_auto_pipenv = 1
let g:ale_python_ruff_change_directory = 1

" Black configuration
let g:ale_python_black_executable = 'black'
let g:ale_python_black_options = '--line-length=88'
let g:ale_python_black_use_global = 0
let g:ale_python_black_auto_pipenv = 1

" --- JAVASCRIPT/TYPESCRIPT SPECIFIC SETTINGS ---

" Prettier configuration (for JS/TS files if needed)
let g:ale_javascript_prettier_executable = 'prettier'
let g:ale_javascript_prettier_use_local_config = 1
let g:ale_typescript_prettier_executable = 'prettier'
let g:ale_typescript_prettier_use_local_config = 1

" --- NAVIGATION KEYBINDINGS ---

" Navigate between errors (same as before)
nmap <silent> <C-e> <Plug>(ale_next_wrap)
nmap <silent> <C-r> <Plug>(ale_previous_wrap)

" Show details
nmap <silent> <leader>ad :ALEDetail<CR>

" Toggle ALE on/off
nmap <silent> <leader>at :ALEToggle<CR>

" --- COMMANDS ---

" Manual fix (same as CoC's :Format command)
command! -nargs=0 Fix :ALEFix

" Show all errors in quickfix
command! -nargs=0 Errors :ALEQuickFix

" --- INTEGRATION WITH LIGHTLINE ---

" ALE integration is handled by lightline if lightline-ale is installed
" If not using lightline-ale, these functions provide statusline info

function! ALEStatus() abort
  if !exists('*ale#statusline#Count')
    return ''
  endif
  
  let l:counts = ale#statusline#Count(bufnr(''))
  let l:all_errors = l:counts.error + l:counts.style_error
  let l:all_warnings = l:counts.warning + l:counts.style_warning
  
  if l:all_errors == 0 && l:all_warnings == 0
    return 'OK'
  endif
  
  return printf('E:%d W:%d', l:all_errors, l:all_warnings)
endfunction

" --- FILETYPE-SPECIFIC SETTINGS ---

" Python
augroup ALEPython
  autocmd!
  autocmd FileType python let b:ale_linters = ['ruff']
  autocmd FileType python let b:ale_fixers = ['ruff', 'black']
augroup END

" Robot Framework - disable ALE (use LSP only)
augroup ALERobot
  autocmd!
  autocmd FileType robot let b:ale_linters = []
  autocmd FileType robot let b:ale_fixers = []
augroup END

" JavaScript/TypeScript - no linting (syntax highlighting only)
augroup ALEJS
  autocmd!
  autocmd FileType javascript,typescript let b:ale_linters = []
  autocmd FileType javascript,typescript let b:ale_fixers = ['prettier']
augroup END

