# API Keys and Tokens - Example Template
# Copy this file to .env_secrets and fill in your actual keys
# DO NOT commit .env_secrets to version control

# OpenAI API Key for shell-gpt and other tools
export OPENAI_API_KEY="your-openai-api-key-here"

# Jira API Token for jira-cli
export JIRA_API_TOKEN="your-jira-api-token-here"

# Shell-GPT API Key
export SHELLGPT_API_KEY="your-shellgpt-api-key-here"
